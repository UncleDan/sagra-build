#!/bin/bash
# ============================================================
# AppRun - Gestione Stand Gastronomico (Sagra3.4.0) via Wine
# Versione: SANT'AGOSTINO
#
# Nell'AppImage restano solo eseguibile, .ini di riferimento e
# librerie. Al primo avvio TUTTO viene copiato nella cartella dati
# esterna (default ~/sagra-santagostino) e l'applicazione gira da li'.
#
#   .exe .dll .ocx .tlb  -> riallineati a ogni avvio (aggiornamento app)
#   .ini .mdb .db e altro -> copiati SOLO se mancanti, mai sovrascritti
#
# Variabili d'ambiente:
#   SAGRA_HOME   cartella dati  (default: ~/sagra-santagostino)
#   WINEPREFIX   prefix Wine    (default: ~/.local/share/sagra-wineprefix)
# ============================================================
set -e

APPDIR="$(dirname "$(readlink -f "${0}")")"
PAYLOAD="$APPDIR/usr/share/sagra/app"

export SAGRA_HOME="${SAGRA_HOME:-$HOME/sagra-santagostino}"
export WINEPREFIX="${WINEPREFIX:-$HOME/.local/share/sagra-santagostino-wineprefix}"
export WINEARCH=win32
export WINEDEBUG="${WINEDEBUG:--all}"

# Estensioni "programma": sempre riallineate alla versione dell'AppImage.
# Tutto il resto (ini, database, archivi, log) e' dato utente: copiato
# solo se assente, mai sovrascritto.
PROGRAM_EXT="exe dll ocx tlb chm"

if ! command -v wine >/dev/null 2>&1; then
    echo "Errore: Wine non e' installato. Installa 'wine' (o 'wine32') dal gestore pacchetti della tua distribuzione."
    exit 1
fi

# ------------------------------------------------------------------
# 1. Prefix Wine + runtime VB6
# ------------------------------------------------------------------
FIRST_RUN=0
if [ ! -d "$WINEPREFIX" ]; then
    FIRST_RUN=1
    echo "Prima esecuzione: creazione ambiente Wine in $WINEPREFIX ..."
    wineboot --init >/dev/null 2>&1
    wineserver -w
fi

SYS32="$WINEPREFIX/drive_c/windows/system32"
mkdir -p "$SYS32"

# Librerie che Wine fornisce gia' in versione propria: sovrascriverle
# con quelle di Windows rompe l'automazione OLE ed e' una causa tipica
# dell'errore 429 "ActiveX component can't create object".
WINE_BUILTIN="oleaut32.dll olepro32.dll asycfilt.dll comcat.dll stdole2.tlb"

e_builtin() {
    local n
    n="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    for b in $WINE_BUILTIN; do
        [ "$n" = "$b" ] && return 0
    done
    return 1
}

installa_runtime() {
    echo "Installazione runtime VB6 nel prefix Wine..."
    local errori=0

    # 1. copia, saltando le librerie native di Wine
    for f in "$APPDIR/usr/share/sagra/sys/"*; do
        [ -e "$f" ] || continue
        local nome
        nome="$(basename "$f")"
        if e_builtin "$nome"; then
            echo "  [salto]     $nome (fornita da Wine)"
            continue
        fi
        cp -f "$f" "$SYS32/"
    done

    # 2. registra i controlli, verificando l'esito uno per uno
    for f in "$SYS32"/*.ocx "$SYS32"/*.OCX "$SYS32"/MSSTDFMT.DLL; do
        [ -e "$f" ] || continue
        local nome
        nome="$(basename "$f")"
        if ( cd "$SYS32" && wine regsvr32 /s "$nome" ) >/dev/null 2>&1; then
            echo "  [ok]        $nome"
        else
            echo "  [FALLITO]   $nome"
            errori=$((errori + 1))
        fi
    done
    wineserver -w

    if [ "$errori" -eq 0 ]; then
        touch "$WINEPREFIX/.sagra_ocx_registered"
        echo "Runtime VB6 registrato correttamente."
    else
        # niente marker: al prossimo avvio si riprova
        rm -f "$WINEPREFIX/.sagra_ocx_registered"
        echo
        echo "ATTENZIONE: $errori componenti non registrati."
        echo "L'applicazione potrebbe dare 'Runtime error 429'."
        echo "Esegui la diagnostica:  \"$0\" --diagnostica"
    fi
    return 0
}

if [ "$FIRST_RUN" -eq 1 ] || [ ! -f "$WINEPREFIX/.sagra_ocx_registered" ]; then
    installa_runtime
fi

# ------------------------------------------------------------------
# 2. Cartella dati esterna persistente
# ------------------------------------------------------------------
is_program_file() {
    local ext="${1##*.}"
    ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
    for e in $PROGRAM_EXT; do
        [ "$ext" = "$e" ] && return 0
    done
    return 1
}

if [ ! -d "$SAGRA_HOME" ]; then
    echo "Primo avvio: creazione cartella dati in $SAGRA_HOME"
    mkdir -p "$SAGRA_HOME"
fi

( cd "$PAYLOAD" && find . -mindepth 1 -type d -print0 ) | \
while IFS= read -r -d '' d; do
    mkdir -p "$SAGRA_HOME/$d"
done

( cd "$PAYLOAD" && find . -type f -print0 ) | \
while IFS= read -r -d '' f; do
    src="$PAYLOAD/$f"
    dst="$SAGRA_HOME/$f"
    if is_program_file "$f"; then
        if [ ! -f "$dst" ] || ! cmp -s "$src" "$dst"; then
            cp -f "$src" "$dst"
        fi
    else
        [ -e "$dst" ] || cp "$src" "$dst"
    fi
done

# ------------------------------------------------------------------
# 3. Mappa la cartella dati su C:\SAGRA dentro Wine
#    (necessario se l'applicazione usa percorsi assoluti)
# ------------------------------------------------------------------
LINK="$WINEPREFIX/drive_c/SAGRA_SANT-AGOSTINO"
if [ -L "$LINK" ]; then
    [ "$(readlink -f "$LINK")" = "$(readlink -f "$SAGRA_HOME")" ] || ln -sfn "$SAGRA_HOME" "$LINK"
elif [ ! -e "$LINK" ]; then
    ln -s "$SAGRA_HOME" "$LINK"
fi

# ------------------------------------------------------------------
# 3b. Voci di menu, raggruppate in una cartella dedicata
# ------------------------------------------------------------------
NOME_MENU="Gestione Stand Gastronomico - Sant'Agostino"
CATEGORIA="X-SagraGSGSA"
ID_MENU="sagra-gsg-santagostino"
REPORT_FILE="report-sagra.html"

crea_voci_menu() {
    local appimage_path desktop_dir icon_dir dirfile menudir
    appimage_path="${APPIMAGE:-$(readlink -f "$0")}"
    desktop_dir="$HOME/.local/share/applications"
    icon_dir="$HOME/.local/share/icons"
    menudir="$HOME/.config/menus/applications-merged"

    mkdir -p "$desktop_dir" "$icon_dir" "$menudir" \
             "$HOME/.local/share/desktop-directories"

    cp -f "$APPDIR/sagra.png" "$icon_dir/$ID_MENU.png" 2>/dev/null || true

    # --- voce principale: l'applicazione ---
    cat > "$desktop_dir/$ID_MENU.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=$NOME_MENU
Comment=Gestione dello stand gastronomico
Exec="$appimage_path"
Icon=$icon_dir/$ID_MENU.png
Categories=Office;$CATEGORIA;
Terminal=false
DESKTOP

    # --- voce report, solo se il file esiste ---
    if [ -f "$SAGRA_HOME/$REPORT_FILE" ]; then
        cat > "$desktop_dir/$ID_MENU-report.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Report Sagra
Comment=Apre il report della sagra nel browser
Exec="$appimage_path" --report
Icon=$icon_dir/$ID_MENU.png
Categories=Office;$CATEGORIA;
Terminal=false
DESKTOP
    else
        rm -f "$desktop_dir/$ID_MENU-report.desktop"
    fi

    # --- cartella di menu che raggruppa le voci ---
    dirfile="$HOME/.local/share/desktop-directories/$ID_MENU.directory"
    cat > "$dirfile" <<DIRECTORY
[Desktop Entry]
Type=Directory
Name=$NOME_MENU
Icon=$icon_dir/$ID_MENU.png
DIRECTORY

    cat > "$menudir/$ID_MENU.menu" <<MENU
<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>$NOME_MENU</Name>
    <Directory>$ID_MENU.directory</Directory>
    <Include>
      <Category>$CATEGORIA</Category>
    </Include>
  </Menu>
</Menu>
MENU

    update-desktop-database "$desktop_dir" >/dev/null 2>&1 || true
}

# le voci vengono riscritte a ogni avvio: cosi' restano valide anche
# se l'AppImage viene spostata
crea_voci_menu

# ------------------------------------------------------------------
# 4. Avvio
# ------------------------------------------------------------------
# --diagnostica: verifica lo stato del runtime VB6 nel prefix Wine
if [ "${1:-}" = "--diagnostica" ]; then
    echo "=== Diagnostica runtime ==="
    echo "WINEPREFIX : $WINEPREFIX"
    echo "SAGRA_HOME : $SAGRA_HOME"
    echo "Wine       : $(wine --version 2>/dev/null || echo 'NON INSTALLATO')"
    echo
    echo "--- Librerie in system32 ---"
    for f in "$APPDIR/usr/share/sagra/sys/"*; do
        n="$(basename "$f")"
        if e_builtin "$n"; then
            echo "  [Wine]      $n (nativa di Wine, non copiata)"
        elif [ -f "$SYS32/$n" ]; then
            echo "  [presente]  $n"
        else
            echo "  [MANCANTE]  $n"
        fi
    done
    echo
    echo "--- Registrazione controlli ---"
    for f in "$SYS32"/*.ocx "$SYS32"/*.OCX; do
        [ -e "$f" ] || continue
        n="$(basename "$f")"
        if ( cd "$SYS32" && wine regsvr32 /s "$n" ) >/dev/null 2>&1; then
            echo "  [ok]        $n"
        else
            echo "  [FALLITO]   $n"
        fi
    done
    wineserver -w
    echo
    echo "--- Componenti per l'accesso ai dati (causa tipica del 429) ---"
    for c in msjet40.dll msjetoledb40.dll dao360.dll msado15.dll; do
        if find "$WINEPREFIX/drive_c" -iname "$c" 2>/dev/null | grep -q .; then
            echo "  [presente]  $c"
        else
            echo "  [assente]   $c"
        fi
    done
    echo
    if command -v winetricks >/dev/null 2>&1; then
        echo "winetricks disponibile. Se i componenti dati sono assenti:"
        echo "  WINEPREFIX=\"$WINEPREFIX\" WINEARCH=win32 winetricks -q vb6run jet40 mdac28"
    else
        echo "winetricks NON installato: e' lo strumento piu' semplice per"
        echo "aggiungere Jet/DAO/ADO, spesso necessari a un'app VB6 con database Access."
        echo "  Debian/Ubuntu:  sudo apt install winetricks"
        echo "Poi:"
        echo "  WINEPREFIX=\"$WINEPREFIX\" WINEARCH=win32 winetricks -q vb6run jet40 mdac28"
    fi
    exit 0
fi

# --ripara-runtime: forza la reinstallazione e registrazione delle librerie
if [ "${1:-}" = "--ripara-runtime" ]; then
    rm -f "$WINEPREFIX/.sagra_ocx_registered"
    installa_runtime
    exit 0
fi

# --backup-setup installa e attiva il backup automatico
if [ "${1:-}" = "--backup-setup" ]; then
    BK="$APPDIR/usr/share/sagra/backup"
    if [ ! -d "$BK" ]; then
        echo "Errore: script di backup non inclusi in questa AppImage."
        exit 1
    fi
    TMPBK="$(mktemp -d)"
    cp -r "$BK/." "$TMPBK/"
    chmod +x "$TMPBK"/*.sh
    # precompila la cartella dati corretta per questa variante
    sed -i "s|^SAGRA_HOME=.*|SAGRA_HOME=\"$SAGRA_HOME\"|" "$TMPBK/config.esempio"
    ( cd "$TMPBK" && ./install.sh )
    rc=$?
    rm -rf "$TMPBK"
    exit $rc
fi

# --backup-status mostra lo stato del backup
if [ "${1:-}" = "--backup-status" ]; then
    systemctl --user list-timers sagra-backup.timer 2>/dev/null || \
        echo "Backup non ancora installato: lancia l'AppImage con --backup-setup"
    echo
    tail -20 "$HOME/.local/state/sagra-backup/backup.log" 2>/dev/null || true
    exit 0
fi

# --report apre il report HTML nel browser invece di lanciare l'app
if [ "${1:-}" = "--report" ]; then
    if [ ! -f "$SAGRA_HOME/$REPORT_FILE" ]; then
        echo "Errore: $REPORT_FILE non presente in $SAGRA_HOME"
        exit 1
    fi
    if command -v xdg-open >/dev/null 2>&1; then
        exec xdg-open "$SAGRA_HOME/$REPORT_FILE"
    else
        echo "xdg-open non disponibile. Apri manualmente:"
        echo "  $SAGRA_HOME/$REPORT_FILE"
        exit 1
    fi
fi

cd "$SAGRA_HOME"
exec wine "C:\\SAGRA_SANT-AGOSTINO\\Sagra3.4.0.exe" "$@"
